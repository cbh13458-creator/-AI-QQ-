# ============================================================
#  QQ AI 机器人 + 微信龙虾(OpenClaw) —— 环境配置
#  复制本文件为 .env 后填写（cp .env.example .env）
# ============================================================

# ============ QQ 机器人 ============
# 在 https://q.qq.com/ 注册机器人后获取
QQ_APP_ID=你的QQ机器人AppID
QQ_APP_SECRET=你的QQ机器人AppSecret

# ============ AI 大模型（OpenAI 兼容接口，任选一家）============
# 你的 AI 厂家：zhipu(智谱) / openai / deepseek / moonshot(月之暗面) / custom
AI_PROVIDER=zhipu

# ---- 智谱 GLM（默认，有免费额度）----
AI_API_KEY=你的智谱API_KEY
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_MODEL=glm-4.7-flash
# 主模型过载时自动切换的备用模型（留空则自动，智谱会降级到 glm-4-flash）
# AI_FALLBACK_MODEL=glm-4-flash

# 视觉模型（识别图片/表情包）
AI_VISION_MODEL=glm-4.6v-flash

# ---- OpenAI（如需用 OpenAI，把上面三行注释掉，取消下面三行注释）----
# AI_API_KEY=sk-你的OpenAI_KEY
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ---- DeepSeek ----
# AI_API_KEY=sk-你的DeepSeek_KEY
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# ---- 自定义 OpenAI 兼容接口 ----
# AI_API_KEY=你的KEY
# AI_BASE_URL=https://你的接口地址/v1
# AI_MODEL=模型名

# ============ 对话参数 ============
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
# 联网搜索：默认开启（免费必应搜索，无需 Key；失败会自动退回普通对话）
AI_WEB_SEARCH=true
# 搜索提供方：bing=免费必应（默认，无需额外 Key）/ zhipu=智谱 Web Search（按次计费）
AI_SEARCH_PROVIDER=bing

# ============ QQ 独占功能 ============
# 摸摸互动：@机器人发「摸摸」有回应
ENABLE_PAT=true
# 定时消息：需先在群里 @ 机器人一次，让它记住群
SCHEDULE_ENABLED=true
# 群内功能目录：@机器人发「菜单 / 目录 / 帮助」返回功能目录
ENABLE_MENU=true
# 群互动：签到 / 积分排行榜 / 群热词（数据存 qq-bot/groupstats.json）
ENABLE_GROUP_TOOLS=true
# 版本更新推送：检测到 GitHub 有新版本时自动推送到用过的群/私聊
ENABLE_UPDATE_PUSH=true
# 多久检查一次新版本（小时）
UPDATE_CHECK_INTERVAL_HOURS=6

# ============ 管理面板 ============
# 只允许手机本机访问填 127.0.0.1；同一局域网其它设备访问填 0.0.0.0
PANEL_HOST=127.0.0.1
PANEL_PORT=8080
# 面板登录密码。PANEL_HOST=0.0.0.0 时必须设置，否则面板拒绝启动；本机访问留空即可
PANEL_PASSWORD=

# ============ 记忆与限额 ============
# 每个会话保留的历史消息条数（一问一答算 2 条，默认 20 条约 10 轮）
AI_MEMORY_MESSAGES=20
# 每人每分钟最多触发 AI 回复的次数（0=不限制）
AI_RATE_PER_MINUTE=6
# 每人每天最多触发 AI 回复的次数（0=不限制）
AI_RATE_PER_DAY=200
